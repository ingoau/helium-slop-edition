+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/helium_workspace_header_view.h"
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/helium/workspaces/helium_workspace_controller.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+
+HeliumWorkspaceHeaderView::HeliumWorkspaceHeaderView(
+    Browser* browser,
+    base::RepeatingClosure clear_ephemeral_callback)
+    : browser_(browser),
+      clear_ephemeral_callback_(std::move(clear_ephemeral_callback)) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 8), 6));
+  Rebuild();
+}
+
+HeliumWorkspaceHeaderView::~HeliumWorkspaceHeaderView() = default;
+
+int HeliumWorkspaceHeaderView::GetHeightForWidth(int width) const {
+  return GetPreferredSize().height();
+}
+
+void HeliumWorkspaceHeaderView::Rebuild() {
+  RemoveAllChildViews();
+  auto* controller = helium::HeliumWorkspaceController::From(browser_);
+  if (!controller) {
+    return;
+  }
+  const auto workspace = controller->GetActiveWorkspace();
+  AddChildView(std::make_unique<views::Label>(workspace.title));
+  auto* clear_button = AddChildView(std::make_unique<views::LabelButton>(
+      clear_ephemeral_callback_, u"Clear"));
+  clear_button->SetTooltipText(u"Clear ephemeral tabs");
+  for (const auto& folder : workspace.pinned_folders) {
+    AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(folder.title)));
+  }
+}
