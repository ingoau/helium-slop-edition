+namespace helium {
+
+struct WorkspacePinnedFolder {
+  std::string id;
+  std::string title;
+  std::vector<std::string> tab_ids;
+};
+
+struct WorkspaceState {
+  std::string id;
+  std::string title;
+  std::string container_id;
+  std::vector<std::string> pinned_tab_ids;
+  std::vector<WorkspacePinnedFolder> pinned_folders;
+  std::vector<std::string> ephemeral_tab_ids;
+};
+
+class HeliumWorkspaceController {
+ public:
+  DECLARE_USER_DATA(HeliumWorkspaceController);
+
+  explicit HeliumWorkspaceController(BrowserWindowInterface* browser_window,
+                                     PrefService* pref_service);
+  HeliumWorkspaceController(const HeliumWorkspaceController&) = delete;
+  HeliumWorkspaceController& operator=(const HeliumWorkspaceController&) =
+      delete;
+  ~HeliumWorkspaceController();
+
+  static HeliumWorkspaceController* From(BrowserWindowInterface* browser_window);
+
+  std::vector<WorkspaceState> GetWorkspaces() const;
+  WorkspaceState GetActiveWorkspace() const;
+  const std::string& active_workspace_id() const {
+    return active_workspace_id_;
+  }
+
+  void AddWorkspace(const std::string& title,
+                    const std::string& container_id = std::string());
+  void RemoveWorkspace(const std::string& workspace_id);
+  void RenameWorkspace(const std::string& workspace_id,
+                       const std::string& title);
+  void SetActiveWorkspace(const std::string& workspace_id);
+  void AssignContainer(const std::string& workspace_id,
+                       const std::string& container_id);
+
+  void PinTab(tabs::TabInterface* tab);
+  void UnpinTab(tabs::TabInterface* tab);
+  void AddPinnedFolder(const std::string& title);
+  void MovePinnedTabToFolder(tabs::TabInterface* tab,
+                             const std::string& folder_id);
+  void RemovePinnedFolder(const std::string& folder_id);
+
+  bool IsTabPinned(tabs::TabInterface* tab) const;
+  bool IsTabEphemeral(tabs::TabInterface* tab) const;
+  void TrackEphemeralTab(tabs::TabInterface* tab);
+  void ClearEphemeralTabs();
+
+  using StateChangedCallback =
+      base::RepeatingCallback<void(HeliumWorkspaceController*)>;
+  base::CallbackListSubscription RegisterOnStateChanged(
+      StateChangedCallback callback);
+
+ private:
+  void EnsureDefaultWorkspace();
+  void LoadActiveWorkspace();
+  void PersistWorkspaces(const std::vector<WorkspaceState>& workspaces);
+  void NotifyStateChanged();
+  std::string EnsureTabId(tabs::TabInterface* tab) const;
+  TabStripModel* tab_strip_model() const;
+
+  raw_ptr<BrowserWindowInterface> browser_window_;
+  raw_ptr<PrefService> pref_service_;
+  PrefChangeRegistrar pref_change_registrar_;
+  std::string active_workspace_id_;
+  base::RepeatingCallbackList<void(HeliumWorkspaceController*)>
+      on_state_changed_callback_list_;
+  ui::ScopedUnownedUserData<HeliumWorkspaceController>
+      scoped_unowned_user_data_;
+};
+
