+#include "chrome/browser/ui/helium/workspaces/helium_workspace_controller.h"
+
+#include <algorithm>
+#include <string_view>
+
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace helium {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kTitleKey[] = "title";
+constexpr char kContainerIdKey[] = "container_id";
+constexpr char kPinnedTabsKey[] = "pinned_tabs";
+constexpr char kPinnedFoldersKey[] = "pinned_folders";
+constexpr char kEphemeralTabsKey[] = "ephemeral_tabs";
+constexpr char kDefaultWorkspaceId[] = "default";
+constexpr char kDefaultWorkspaceTitle[] = "Personal";
+
+std::vector<std::string> ListToStrings(const base::Value::List* list) {
+  std::vector<std::string> strings;
+  if (!list) {
+    return strings;
+  }
+  for (const auto& value : *list) {
+    if (value.is_string()) {
+      strings.push_back(value.GetString());
+    }
+  }
+  return strings;
+}
+
+base::Value::List StringsToList(const std::vector<std::string>& strings) {
+  base::Value::List list;
+  for (const auto& value : strings) {
+    list.Append(value);
+  }
+  return list;
+}
+
+WorkspacePinnedFolder FolderFromDict(const base::Value::Dict& dict) {
+  WorkspacePinnedFolder folder;
+  folder.id = dict.FindString(kIdKey).value_or(std::string());
+  folder.title = dict.FindString(kTitleKey).value_or(std::string());
+  folder.tab_ids = ListToStrings(dict.FindList(kPinnedTabsKey));
+  return folder;
+}
+
+base::Value::Dict FolderToDict(const WorkspacePinnedFolder& folder) {
+  base::Value::Dict dict;
+  dict.Set(kIdKey, folder.id);
+  dict.Set(kTitleKey, folder.title);
+  dict.Set(kPinnedTabsKey, StringsToList(folder.tab_ids));
+  return dict;
+}
+
+WorkspaceState WorkspaceFromDict(const base::Value::Dict& dict) {
+  WorkspaceState workspace;
+  workspace.id = dict.FindString(kIdKey).value_or(std::string());
+  workspace.title = dict.FindString(kTitleKey).value_or(std::string());
+  workspace.container_id =
+      dict.FindString(kContainerIdKey).value_or(std::string());
+  workspace.pinned_tab_ids = ListToStrings(dict.FindList(kPinnedTabsKey));
+  workspace.ephemeral_tab_ids = ListToStrings(dict.FindList(kEphemeralTabsKey));
+  if (const auto* folders = dict.FindList(kPinnedFoldersKey)) {
+    for (const auto& folder : *folders) {
+      if (folder.is_dict()) {
+        workspace.pinned_folders.push_back(FolderFromDict(folder.GetDict()));
+      }
+    }
+  }
+  return workspace;
+}
+
+base::Value::Dict WorkspaceToDict(const WorkspaceState& workspace) {
+  base::Value::Dict dict;
+  dict.Set(kIdKey, workspace.id);
+  dict.Set(kTitleKey, workspace.title);
+  dict.Set(kContainerIdKey, workspace.container_id);
+  dict.Set(kPinnedTabsKey, StringsToList(workspace.pinned_tab_ids));
+  dict.Set(kEphemeralTabsKey, StringsToList(workspace.ephemeral_tab_ids));
+  base::Value::List folders;
+  for (const auto& folder : workspace.pinned_folders) {
+    folders.Append(FolderToDict(folder));
+  }
+  dict.Set(kPinnedFoldersKey, std::move(folders));
+  return dict;
+}
+
+bool Contains(const std::vector<std::string>& values, std::string_view id) {
+  return std::ranges::find(values, id) != values.end();
+}
+
+void Erase(std::vector<std::string>& values, std::string_view id) {
+  std::erase(values, id);
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumWorkspaceController);
+
+HeliumWorkspaceController::HeliumWorkspaceController(
+    BrowserWindowInterface* browser_window,
+    PrefService* pref_service)
+    : browser_window_(browser_window),
+      pref_service_(pref_service),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  pref_change_registrar_.Init(pref_service_);
+  pref_change_registrar_.Add(
+      prefs::kHeliumWorkspaces,
+      base::BindRepeating(&HeliumWorkspaceController::NotifyStateChanged,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(
+      prefs::kHeliumActiveWorkspace,
+      base::BindRepeating(&HeliumWorkspaceController::LoadActiveWorkspace,
+                          base::Unretained(this)));
+  EnsureDefaultWorkspace();
+  LoadActiveWorkspace();
+}
+
+HeliumWorkspaceController::~HeliumWorkspaceController() = default;
+
+HeliumWorkspaceController* HeliumWorkspaceController::From(
+    BrowserWindowInterface* browser_window) {
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+std::vector<WorkspaceState> HeliumWorkspaceController::GetWorkspaces() const {
+  std::vector<WorkspaceState> workspaces;
+  const base::Value::Dict& dict =
+      pref_service_->GetDict(prefs::kHeliumWorkspaces);
+  for (const auto [id, value] : dict) {
+    if (value.is_dict()) {
+      WorkspaceState workspace = WorkspaceFromDict(value.GetDict());
+      if (workspace.id.empty()) {
+        workspace.id = id;
+      }
+      workspaces.push_back(std::move(workspace));
+    }
+  }
+  std::ranges::sort(workspaces, {}, &WorkspaceState::title);
+  return workspaces;
+}
+
+WorkspaceState HeliumWorkspaceController::GetActiveWorkspace() const {
+  for (auto& workspace : GetWorkspaces()) {
+    if (workspace.id == active_workspace_id_) {
+      return workspace;
+    }
+  }
+  return WorkspaceState{kDefaultWorkspaceId, kDefaultWorkspaceTitle};
+}
+
+void HeliumWorkspaceController::AddWorkspace(const std::string& title,
+                                             const std::string& container_id) {
+  auto workspaces = GetWorkspaces();
+  WorkspaceState workspace;
+  workspace.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  workspace.title = title.empty() ? "Workspace" : title;
+  workspace.container_id = container_id;
+  workspaces.push_back(std::move(workspace));
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::RemoveWorkspace(
+    const std::string& workspace_id) {
+  if (workspace_id == kDefaultWorkspaceId) {
+    return;
+  }
+  auto workspaces = GetWorkspaces();
+  std::erase_if(workspaces, [&](const WorkspaceState& workspace) {
+    return workspace.id == workspace_id;
+  });
+  PersistWorkspaces(workspaces);
+  if (active_workspace_id_ == workspace_id) {
+    SetActiveWorkspace(kDefaultWorkspaceId);
+  }
+}
+
+void HeliumWorkspaceController::RenameWorkspace(
+    const std::string& workspace_id,
+    const std::string& title) {
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    if (workspace.id == workspace_id) {
+      workspace.title = title;
+      break;
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::SetActiveWorkspace(
+    const std::string& workspace_id) {
+  pref_service_->SetString(prefs::kHeliumActiveWorkspace, workspace_id);
+}
+
+void HeliumWorkspaceController::AssignContainer(
+    const std::string& workspace_id,
+    const std::string& container_id) {
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    if (workspace.id == workspace_id) {
+      workspace.container_id = container_id;
+      break;
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::PinTab(tabs::TabInterface* tab) {
+  const std::string tab_id = EnsureTabId(tab);
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    if (workspace.id != active_workspace_id_) {
+      continue;
+    }
+    Erase(workspace.ephemeral_tab_ids, tab_id);
+    if (!Contains(workspace.pinned_tab_ids, tab_id)) {
+      workspace.pinned_tab_ids.push_back(tab_id);
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::UnpinTab(tabs::TabInterface* tab) {
+  const std::string tab_id = EnsureTabId(tab);
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    Erase(workspace.pinned_tab_ids, tab_id);
+    for (auto& folder : workspace.pinned_folders) {
+      Erase(folder.tab_ids, tab_id);
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::AddPinnedFolder(const std::string& title) {
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    if (workspace.id == active_workspace_id_) {
+      workspace.pinned_folders.push_back(WorkspacePinnedFolder{
+          base::Uuid::GenerateRandomV4().AsLowercaseString(),
+          title.empty() ? "Folder" : title,
+          {}});
+      break;
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::MovePinnedTabToFolder(
+    tabs::TabInterface* tab,
+    const std::string& folder_id) {
+  const std::string tab_id = EnsureTabId(tab);
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    if (workspace.id != active_workspace_id_) {
+      continue;
+    }
+    Erase(workspace.pinned_tab_ids, tab_id);
+    for (auto& folder : workspace.pinned_folders) {
+      if (folder.id == folder_id && !Contains(folder.tab_ids, tab_id)) {
+        folder.tab_ids.push_back(tab_id);
+      }
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::RemovePinnedFolder(
+    const std::string& folder_id) {
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    std::erase_if(workspace.pinned_folders, [&](const auto& folder) {
+      return folder.id == folder_id;
+    });
+  }
+  PersistWorkspaces(workspaces);
+}
+
+bool HeliumWorkspaceController::IsTabPinned(tabs::TabInterface* tab) const {
+  const std::string tab_id = EnsureTabId(tab);
+  const WorkspaceState workspace = GetActiveWorkspace();
+  if (Contains(workspace.pinned_tab_ids, tab_id)) {
+    return true;
+  }
+  for (const auto& folder : workspace.pinned_folders) {
+    if (Contains(folder.tab_ids, tab_id)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HeliumWorkspaceController::IsTabEphemeral(tabs::TabInterface* tab) const {
+  return !IsTabPinned(tab);
+}
+
+void HeliumWorkspaceController::TrackEphemeralTab(tabs::TabInterface* tab) {
+  if (!pref_service_->GetBoolean(prefs::kHeliumWorkspaceEphemeralTabs)) {
+    return;
+  }
+  const std::string tab_id = EnsureTabId(tab);
+  auto workspaces = GetWorkspaces();
+  for (auto& workspace : workspaces) {
+    if (workspace.id == active_workspace_id_ &&
+        !Contains(workspace.ephemeral_tab_ids, tab_id)) {
+      workspace.ephemeral_tab_ids.push_back(tab_id);
+      break;
+    }
+  }
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::ClearEphemeralTabs() {
+  auto* model = tab_strip_model();
+  if (!model) {
+    return;
+  }
+  for (int index = model->count() - 1; index >= 0; --index) {
+    auto* tab = model->GetTabAtIndex(index);
+    if (tab && IsTabEphemeral(tab)) {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+}
+
+base::CallbackListSubscription
+HeliumWorkspaceController::RegisterOnStateChanged(
+    StateChangedCallback callback) {
+  return on_state_changed_callback_list_.Add(std::move(callback));
+}
+
+void HeliumWorkspaceController::EnsureDefaultWorkspace() {
+  auto workspaces = GetWorkspaces();
+  const bool has_default = std::ranges::any_of(workspaces, [](const auto& ws) {
+    return ws.id == kDefaultWorkspaceId;
+  });
+  if (has_default) {
+    return;
+  }
+  workspaces.push_back(
+      WorkspaceState{kDefaultWorkspaceId, kDefaultWorkspaceTitle});
+  PersistWorkspaces(workspaces);
+}
+
+void HeliumWorkspaceController::LoadActiveWorkspace() {
+  active_workspace_id_ =
+      pref_service_->GetString(prefs::kHeliumActiveWorkspace);
+  if (active_workspace_id_.empty()) {
+    active_workspace_id_ = kDefaultWorkspaceId;
+  }
+  NotifyStateChanged();
+}
+
+void HeliumWorkspaceController::PersistWorkspaces(
+    const std::vector<WorkspaceState>& workspaces) {
+  base::Value::Dict dict;
+  for (const auto& workspace : workspaces) {
+    dict.Set(workspace.id, WorkspaceToDict(workspace));
+  }
+  pref_service_->SetDict(prefs::kHeliumWorkspaces, std::move(dict));
+}
+
+void HeliumWorkspaceController::NotifyStateChanged() {
+  on_state_changed_callback_list_.Notify(this);
+}
+
+std::string HeliumWorkspaceController::EnsureTabId(
+    tabs::TabInterface* tab) const {
+  return tab ? tab->GetHandle().raw_value().ToString() : std::string();
+}
+
+TabStripModel* HeliumWorkspaceController::tab_strip_model() const {
+  return browser_window_ ? browser_window_->GetTabStripModel() : nullptr;
+}
