+void BrowserView::UpdateToolbarSidebarParent() {
+  if (!toolbar_ || !top_container_) {
+    return;
+  }
+  const bool sidebar_toolbar =
+      IsToolbarInSidebar() && ShouldDrawVerticalTabStrip() &&
+      vertical_tab_strip_region_view_;
+  views::View* target_parent =
+      sidebar_toolbar ? vertical_tab_strip_region_view_ : top_container_;
+  if (toolbar_->parent() == target_parent) {
+    return;
+  }
+  toolbar_->parent()->RemoveChildViewT(toolbar_.get());
+  target_parent->AddChildViewAt(toolbar_.get(), 0);
+  toolbar_->UpdateToolbarLayout();
+  if (sidebar_toolbar) {
+    browser_->profile()->GetPrefs()->SetBoolean(
+        prefs::kHeliumZenModeSidebarPinned, true);
+    browser_->profile()->GetPrefs()->SetBoolean(
+        prefs::kHeliumZenModeTopChromePinned, false);
+  }
+  InvalidateLayout();
+}
