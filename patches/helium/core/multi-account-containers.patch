+};
+
+class HeliumContainerService {
+ public:
+  DECLARE_USER_DATA(HeliumContainerService);
+
+  HeliumContainerService(BrowserWindowInterface* browser_window,
+                         Profile* profile,
+                         PrefService* pref_service);
+  HeliumContainerService(const HeliumContainerService&) = delete;
+  HeliumContainerService& operator=(const HeliumContainerService&) = delete;
+  ~HeliumContainerService();
+
+  static HeliumContainerService* From(BrowserWindowInterface* browser_window);
+
+  std::vector<ContainerState> GetContainers() const;
+  ContainerState GetContainer(const std::string& container_id) const;
+  void AddContainer(const std::string& name,
+                    const std::string& color,
+                    const std::string& icon);
+  void RemoveContainer(const std::string& container_id);
+  void AssignTab(tabs::TabInterface* tab, const std::string& container_id);
+  std::string GetContainerForTab(tabs::TabInterface* tab) const;
+  std::string GetContainerForNewTab() const;
+
+  content::StoragePartitionConfig GetStoragePartitionConfigForContainer(
+      const std::string& container_id) const;
+
+ private:
+  void EnsureDefaultContainers();
+  void PersistContainers(const std::vector<ContainerState>& containers);
+  std::string TabId(tabs::TabInterface* tab) const;
+
+  raw_ptr<BrowserWindowInterface> browser_window_;
+  raw_ptr<Profile> profile_;
+  raw_ptr<PrefService> pref_service_;
+  PrefChangeRegistrar pref_change_registrar_;
+  ui::ScopedUnownedUserData<HeliumContainerService> scoped_unowned_user_data_;
+};
+
+}  // namespace helium
