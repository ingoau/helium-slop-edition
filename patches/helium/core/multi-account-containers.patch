@@ -0,0 +1,210 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/containers/helium_container_service.h"
+
+#include <algorithm>
+
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium/workspaces/helium_workspace_controller.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace helium {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kColorKey[] = "color";
+constexpr char kIconKey[] = "icon";
+constexpr char kPartitionNameKey[] = "partition_name";
+
+ContainerState ContainerFromDict(const base::Value::Dict& dict) {
+  ContainerState container;
+  container.id = dict.FindString(kIdKey).value_or(std::string());
+  container.name = dict.FindString(kNameKey).value_or(std::string());
+  container.color = dict.FindString(kColorKey).value_or("#5f6368");
+  container.icon = dict.FindString(kIconKey).value_or("circle");
+  container.partition_name =
+      dict.FindString(kPartitionNameKey).value_or(container.id);
+  return container;
+}
+
+base::Value::Dict ContainerToDict(const ContainerState& container) {
+  base::Value::Dict dict;
+  dict.Set(kIdKey, container.id);
+  dict.Set(kNameKey, container.name);
+  dict.Set(kColorKey, container.color);
+  dict.Set(kIconKey, container.icon);
+  dict.Set(kPartitionNameKey, container.partition_name);
+  return dict;
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumContainerService);
+
+HeliumContainerService::HeliumContainerService(
+    BrowserWindowInterface* browser_window,
+    Profile* profile,
+    PrefService* pref_service)
+    : browser_window_(browser_window),
+      profile_(profile),
+      pref_service_(pref_service),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  EnsureDefaultContainers();
+}
+
+HeliumContainerService::~HeliumContainerService() = default;
+
+HeliumContainerService* HeliumContainerService::From(
+    BrowserWindowInterface* browser_window) {
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+std::vector<ContainerState> HeliumContainerService::GetContainers() const {
+  std::vector<ContainerState> containers;
+  const base::Value::Dict& dict =
+      pref_service_->GetDict(prefs::kHeliumContainers);
+  for (const auto [id, value] : dict) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    ContainerState container = ContainerFromDict(value.GetDict());
+    if (container.id.empty()) {
+      container.id = id;
+    }
+    containers.push_back(std::move(container));
+  }
+  std::ranges::sort(containers, {}, &ContainerState::name);
+  return containers;
+}
+
+ContainerState HeliumContainerService::GetContainer(
+    const std::string& container_id) const {
+  for (const auto& container : GetContainers()) {
+    if (container.id == container_id) {
+      return container;
+    }
+  }
+  return ContainerState();
+}
+
+void HeliumContainerService::AddContainer(const std::string& name,
+                                          const std::string& color,
+                                          const std::string& icon) {
+  auto containers = GetContainers();
+  ContainerState container;
+  container.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  container.name = name.empty() ? "Container" : name;
+  container.color = color.empty() ? "#5f6368" : color;
+  container.icon = icon.empty() ? "circle" : icon;
+  container.partition_name = "helium-container-" + container.id;
+  containers.push_back(std::move(container));
+  PersistContainers(containers);
+}
+
+void HeliumContainerService::RemoveContainer(
+    const std::string& container_id) {
+  auto containers = GetContainers();
+  std::erase_if(containers, [&](const ContainerState& container) {
+    return container.id == container_id;
+  });
+  PersistContainers(containers);
+}
+
+void HeliumContainerService::AssignTab(tabs::TabInterface* tab,
+                                       const std::string& container_id) {
+  base::Value::Dict tab_map =
+      pref_service_->GetDict(prefs::kHeliumTabContainers).Clone();
+  const std::string id = TabId(tab);
+  if (container_id.empty()) {
+    tab_map.Remove(id);
+  } else {
+    tab_map.Set(id, container_id);
+  }
+  pref_service_->SetDict(prefs::kHeliumTabContainers, std::move(tab_map));
+}
+
+std::string HeliumContainerService::GetContainerForTab(
+    tabs::TabInterface* tab) const {
+  if (!pref_service_->GetBoolean(prefs::kHeliumContainersEnabled)) {
+    return std::string();
+  }
+  const base::Value::Dict& tab_map =
+      pref_service_->GetDict(prefs::kHeliumTabContainers);
+  if (const auto* container = tab_map.FindString(TabId(tab))) {
+    return *container;
+  }
+  if (auto* workspace_controller =
+          HeliumWorkspaceController::From(browser_window_)) {
+    std::string workspace_container =
+        workspace_controller->GetActiveWorkspace().container_id;
+    if (!workspace_container.empty()) {
+      return workspace_container;
+    }
+  }
+  return pref_service_->GetString(prefs::kHeliumDefaultContainer);
+}
+
+std::string HeliumContainerService::GetContainerForNewTab() const {
+  if (!pref_service_->GetBoolean(prefs::kHeliumContainersEnabled)) {
+    return std::string();
+  }
+  if (auto* workspace_controller =
+          HeliumWorkspaceController::From(browser_window_)) {
+    std::string workspace_container =
+        workspace_controller->GetActiveWorkspace().container_id;
+    if (!workspace_container.empty()) {
+      return workspace_container;
+    }
+  }
+  return pref_service_->GetString(prefs::kHeliumDefaultContainer);
+}
+
+content::StoragePartitionConfig
+HeliumContainerService::GetStoragePartitionConfigForContainer(
+    const std::string& container_id) const {
+  if (container_id.empty()) {
+    return content::StoragePartitionConfig::CreateDefault(profile_);
+  }
+  const ContainerState container = GetContainer(container_id);
+  if (container.id.empty()) {
+    return content::StoragePartitionConfig::CreateDefault(profile_);
+  }
+  return content::StoragePartitionConfig::Create(profile_, container.partition_name,
+                                                /*in_memory=*/false);
+}
+
+void HeliumContainerService::EnsureDefaultContainers() {
+  if (!GetContainers().empty()) {
+    return;
+  }
+  std::vector<ContainerState> containers = {
+      {"personal", "Personal", "#1a73e8", "person", "helium-container-personal"},
+      {"work", "Work", "#188038", "briefcase", "helium-container-work"},
+      {"banking", "Banking", "#c5221f", "lock", "helium-container-banking"},
+  };
+  PersistContainers(containers);
+}
+
+void HeliumContainerService::PersistContainers(
+    const std::vector<ContainerState>& containers) {
+  base::Value::Dict dict;
+  for (const auto& container : containers) {
+    dict.Set(container.id, ContainerToDict(container));
+  }
+  pref_service_->SetDict(prefs::kHeliumContainers, std::move(dict));
+}
+
+std::string HeliumContainerService::TabId(tabs::TabInterface* tab) const {
+  return tab ? tab->GetHandle().raw_value().ToString() : std::string();
+}
+
+}  // namespace helium
